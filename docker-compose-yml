services:

  web:
    build: .  
    ports:
      - "8004:80"  
    volumes:
      - ./src:/var/www/html 
    depends_on:
      - db

  db:
    image: mysql:8.4
    ports:
      - "3310:3306" 
    environment:
      MYSQL_ROOT_PASSWORD: root 
    volumes:
      - ./mysql_data:/var/lib/mysql

  
  phpmyadmin:
    image: phpmyadmin
    ports:
      - "8085:80" 
    environment:
      PMA_HOST: db
      MYSQL_ROOT_PASSWORD: root